# Copy to "Portfolio Projects/.env" (two folders up) or to a local .env in this repo.
# Names only: never commit real values.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MODEL_MAIN=
MODEL_CHEAP=
# Must be from a different model family than MODEL_MAIN / MODEL_CHEAP
MODEL_JUDGE=

# Optional
# Budget guard for evals.run (US$); the run stops when it is passed
MAX_COST_PER_RUN_USD=3
# Hidden "reasoning" effort asked from every model call: low (default), medium, high, or "default" to send nothing
REASONING_EFFORT=
# Messages per session in the Gradio demo
DEMO_MESSAGE_LIMIT=20
# Talk to a real running courier mock (uvicorn) instead of calling it in-process
COURIER_API_URL=
# Who uses the Approvals tab: the role is set here, not chosen on screen.
# APPROVER_ROLE is "team" (default) or "supervisor" (needed for refunds above AED 200).
APPROVER_ID=
APPROVER_ROLE=
# Where the demo keeps CRM/approval state (default: ./runtime)
SHOP_RUNTIME_DIR=
